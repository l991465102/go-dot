GO_DOT_MYSQL_ROOT_PASSWORD=local-mysql-root-change-before-production
GO_DOT_MYSQL_DSN=root:local-mysql-root-change-before-production@tcp(mysql:3306)/go_dot?parseTime=true
GO_DOT_REDIS_ADDRESS=redis:6379
GO_DOT_QUEUE_EVENT_STREAM=tracking:{queue}:events
GO_DOT_QUEUE_INVALID_STREAM=tracking:{queue}:invalid
GO_DOT_QUEUE_DEAD_STREAM=tracking:{queue}:dead
GO_DOT_QUEUE_CONSUMER_GROUP=tracking-workers
GO_DOT_QUEUE_PUBLISH_DEDUP_TTL=72h
GO_DOT_WORKER_CONCURRENCY=8
GO_DOT_WORKER_MAX_DELIVERIES=5
GO_DOT_WORKER_RECLAIM_IDLE=30s
GO_DOT_WORKER_DRAIN_TIMEOUT=30s
GO_DOT_WORKER_RETRY_BASE=1s
GO_DOT_WORKER_RETRY_MAX=1m
GO_DOT_SCHEDULER_AGGREGATE_EVERY=1m
GO_DOT_SCHEDULER_AGGREGATE_LOOKBACK_HOURS=2
GO_DOT_SCHEDULER_RECLAIM_EVERY=15s
GO_DOT_SCHEDULER_METRICS_EVERY=1m
GO_DOT_SCHEDULER_EXPIRE_KEYS_EVERY=1h
GO_DOT_SCHEDULER_RECLAIM_IDLE=1m
GO_DOT_SCHEDULER_LEASE_TTL=2m
GO_DOT_SCHEDULER_BATCH_SIZE=100
GO_DOT_CLICKHOUSE_DSN=clickhouse://default:@clickhouse:9000/go_dot
GO_DOT_JWT_SECRET=local-jwt-secret-change-before-production
GO_DOT_VISITOR_MASTER_KEY=local-visitor-key-change-before-production
# Use true only when browsers access the service through HTTPS; Secure cookies are not sent over plain HTTP.
GO_DOT_SECURE_COOKIES=false
