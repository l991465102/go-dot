FROM golang:1.26.5 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/go-dot .

FROM golang:1.26.5

WORKDIR /app
COPY --from=build /out/go-dot /app/go-dot
COPY migrations /app/migrations
COPY manifest /app/manifest
ENTRYPOINT ["/app/go-dot"]
