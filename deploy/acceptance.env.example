GO_DOT_MYSQL_ROOT_PASSWORD=acceptance-root-password
GO_DOT_MYSQL_DSN=root:acceptance-root-password@tcp(mysql:3306)/go_dot?parseTime=true
GO_DOT_REDIS_ADDRESS=redis:6379
GO_DOT_CLICKHOUSE_DSN=clickhouse://default:@clickhouse:9000/go_dot
GO_DOT_JWT_SECRET=acceptance-only-jwt-secret-change-for-shared-hosts
GO_DOT_VISITOR_MASTER_KEY=acceptance-only-visitor-key-change-for-shared-hosts
GO_DOT_SECURE_COOKIES=false
GO_DOT_SCHEDULER_AGGREGATE_EVERY=5s
GO_DOT_SCHEDULER_METRICS_EVERY=5s
